<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:padding="6dp">

        <Button
            android:id="@+id/tab_owner_btn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/tab_active"
            android:textColor="@android:color/white"
            android:text="@string/tab_owner"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tab_records_btn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/tab_inactive"
            android:textColor="@color/primary"
            android:text="@string/tab_records"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/owner_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:elevation="2dp"
                android:padding="18dp">

                <TextView
                    android:id="@+id/owner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/owner_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/edit_owner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:textColor="@android:color/white"
                android:text="@string/edit_record"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/records_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_apartments" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingBottom="10dp" />
            <LinearLayout android:id="@+id/apartments" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_requests" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingTop="16dp" android:paddingBottom="10dp" />
            <LinearLayout android:id="@+id/requests" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_charges" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingStart="2dp" android:paddingTop="16dp" android:paddingBottom="10dp" />
            <LinearLayout android:id="@+id/charges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
