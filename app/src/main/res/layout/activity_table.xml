<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/search_box"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/list_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card"
                android:padding="8dp">

                <Button android:id="@+id/nav_first" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="12sp" android:text="@string/nav_first" android:paddingStart="12dp" android:paddingEnd="12dp" />
                <Button android:id="@+id/nav_prev" android:layout_width="40dp" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="20sp" android:text="@string/nav_prev" android:padding="0dp" android:layout_marginStart="6dp" />
                <Button android:id="@+id/nav_next" android:layout_width="40dp" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="20sp" android:text="@string/nav_next" android:padding="0dp" android:layout_marginStart="6dp" />
                <Button android:id="@+id/nav_last" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="12sp" android:text="@string/nav_last" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" />

                <EditText
                    android:id="@+id/record_number"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:background="@drawable/search_box"
                    android:hint="@string/record_number"
                    android:inputType="number"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:importantForAutofill="no"
                    android:layout_marginStart="10dp" />

                <Button android:id="@+id/find" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="12sp" android:text="@string/find" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" />
                <Button android:id="@+id/open" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_primary" android:textColor="@android:color/white" android:textSize="12sp" android:text="@string/open" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" />
                <Button android:id="@+id/edit_record" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="12sp" android:text="@string/edit_record" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" />
                <Button android:id="@+id/delete_selected" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_danger" android:textColor="@color/btn_danger_text" android:textSize="12sp" android:text="@string/delete" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" />
                <Button android:id="@+id/owner_card" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_secondary" android:textColor="@color/btn_secondary_text" android:textSize="12sp" android:text="@string/owner_card" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_primary"
                android:textColor="@android:color/white"
                android:text="@string/add_record"
                android:textSize="13sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <TextView
                android:id="@+id/count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:paddingStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingStart="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp" />

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:cacheColorHint="@android:color/transparent"
            android:choiceMode="singleChoice"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent"
            android:scrollbarStyle="outsideOverlay" />
    </LinearLayout>
</LinearLayout>
